{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bnp.invalid/schema/v1/node-profile.schema.json",
  "title": "BNP v1 Node Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "status",
    "profile_version",
    "protocol_versions",
    "active_keys",
    "capabilities",
    "visibility_scope",
    "interfaces",
    "declared_endpoints",
    "runtime_endpoints"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "status": {
      "enum": ["pending", "active", "rotating", "suspended", "revoked"]
    },
    "profile_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "active_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "algorithm", "state"],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          },
          "algorithm": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "state": {
            "enum": ["active", "rotating", "revoked"]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "visibility_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interface_id", "version"],
        "properties": {
          "interface_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "declared_endpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endpoint"
      }
    },
    "runtime_endpoints": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/endpoint" },
          {
            "type": "object",
            "required": ["observed_state"],
            "properties": {
              "observed_state": {
                "enum": ["unknown", "up", "down", "degraded"]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_id", "transport", "address"],
      "properties": {
        "endpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "transport": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "interface_id": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}

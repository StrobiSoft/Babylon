@@ -0,0 +1,42 @@
+export interface CanonicalCConfiguration {
+  stages: number[];
+  modes: string[];
+  poolMax: number;
+  pollIntervalMs: number;
+  pendingSchedule: string;
+  clientRampMs: number;
+  warmupMs: number;
+  separateServerProcess: boolean;
+  comparisonRun: boolean;
+  pendingAuthIsolation: string;
+}
+
+export function assertCanonicalCConfiguration(configuration: CanonicalCConfiguration): void {
+  const violations = [
+    configuration.stages.length === 1 && configuration.stages[0] === 500
+      ? undefined
+      : 'SOFT_CHAT_LOAD_STAGES must be exactly 500',
+    configuration.modes.length === 1 && configuration.modes[0] === 'independent-streaming'
+      ? undefined
+      : 'SOFT_CHAT_LOAD_MODES must be exactly independent-streaming',
+    configuration.poolMax === 20 ? undefined : 'SOFT_CHAT_LOAD_POOL_MAX must be 20',
+    configuration.pollIntervalMs === 500
+      ? undefined
+      : 'SOFT_CHAT_LOAD_POLL_INTERVAL_MS must be 500',
+    configuration.pendingSchedule === 'fixed-grid'
+      ? undefined
+      : 'SOFT_CHAT_LOAD_PENDING_SCHEDULE must be fixed-grid',
+    configuration.clientRampMs === 5000 ? undefined : 'SOFT_CHAT_LOAD_CLIENT_RAMP_MS must be 5000',
+    configuration.warmupMs === 2000 ? undefined : 'SOFT_CHAT_LOAD_WARMUP_MS must be 2000',
+    configuration.separateServerProcess
+      ? undefined
+      : 'SOFT_CHAT_LOAD_SEPARATE_SERVER must be enabled',
+    configuration.comparisonRun ? undefined : 'SOFT_CHAT_LOAD_COMPARISON must be enabled',
+    configuration.pendingAuthIsolation === 'none'
+      ? undefined
+      : 'SOFT_CHAT_LOAD_PENDING_AUTH_ISOLATION must preserve the Delta 1.1 default (none)',
+  ].filter((value): value is string => value !== undefined);
+  if (violations.length > 0) {
+    throw new Error(`Canonical C configuration refused: ${violations.join('; ')}`);
+  }
+}

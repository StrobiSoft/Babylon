@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest';
+import { assertCanonicalCConfiguration } from './soft-chat-canonical-c-config.js';
+
+const canonical = {
+  stages: [500],
+  modes: ['independent-streaming'],
+  poolMax: 20,
+  pollIntervalMs: 500,
+  pendingSchedule: 'fixed-grid',
+  clientRampMs: 5000,
+  warmupMs: 2000,
+  separateServerProcess: true,
+  comparisonRun: true,
+  pendingAuthIsolation: 'none',
+};
+
+describe('canonical C configuration guard', () => {
+  it('accepts the exact issue #57 C workload', () => {
+    expect(() => assertCanonicalCConfiguration(canonical)).not.toThrow();
+  });
+
+  it.each([
+    ['client count', { stages: [499] }],
+    ['mode', { modes: ['shared-phased'] }],
+    ['pool max', { poolMax: 40 }],
+    ['poll interval', { pollIntervalMs: 750 }],
+    ['scheduler', { pendingSchedule: 'completion-relative' }],
+    ['ramp', { clientRampMs: 0 }],
+    ['warmup', { warmupMs: 0 }],
+    ['server topology', { separateServerProcess: false }],
+    ['comparison mode', { comparisonRun: false }],
+    ['pending auth behavior', { pendingAuthIsolation: 'prevalidated-handle' }],
+  ])('refuses a changed %s', (_label, change) => {
+    expect(() => assertCanonicalCConfiguration({ ...canonical, ...change })).toThrow(
+      'Canonical C configuration refused',
+    );
+  });
+});
diff --git a/babylon-project/backend/test/soft-chat-canonical-c-config.ts b/babylon-project/backend/test/soft-chat-canonical-c-config.ts
